// ==============================================================================
// Microsoft Sentinel Analytics Rule
// Rule Name & ID: R01 - Password Spraying (Pulverización de Contraseñas)
// MITRE ATT&CK:
//   - Tactic: Credential Access (TA0006)
//   - Technique: T1110.003 (Brute Force: Password Spraying)
// Severity: Medium / Alto (según progresión o correlación posterior)
// Data Source: SecurityEvent (Windows Security Event Log)
//
// Threshold:
//   - Time Window: 15 minutes (ventana temporal de 15 minutos)
//   - Failed Logons: >= 10 failed logon attempts (EventID 4625)
//   - Target Users: >= 5 distinct target accounts (dcount TargetUserName >= 5)
//   - Source Address: External IP address (non-RFC1918, non-loopback)
//
// Python Equivalence:
//   Mirrors `detections.py` constants:
//     R1_FAILED_LOGONS_THRESHOLD = 10
//     R1_DISTINCT_USERS_THRESHOLD = 5
//     R1_TIME_WINDOW_MINUTES = 15
//   Evaluates Event_ID == "4625" with is_external_ip == True grouped by Source_IP
//   over a 15-minute sliding window checking for >= 10 failures and >= 5 distinct users.
//
// Expected False Positives & Tuning Guidance:
//   - Multi-tenant reverse proxies or shared enterprise egress gateways.
//   - Directory synchronization agents or automated identity migration tools with stale secrets.
//   - Scheduled vulnerability scans or authorized red team / penetration testing exercises.
//   - Tuning: Whitelist verified enterprise proxy/VPN egress IP addresses or maintain
//     a Sentinel Watchlist (`_GetWatchlist('AuthorizedSecurityScanners')`) to filter out
//     authorized scanner IPs.
// ==============================================================================

let timeframe = 1h;
let lookbackWindow = 15m;
let FailedLogonsThreshold = 10;
let DistinctUsersThreshold = 5;
SecurityEvent
| where TimeGenerated >= ago(timeframe)
| where EventID == 4625
// Filtrar direcciones IP no válidas o locales (RFC 1918 y loopback)
| where isnotempty(IpAddress) and IpAddress !in ("-", "127.0.0.1", "::1", "0.0.0.0")
| where ipv4_is_private(IpAddress) == false
// Filtrar cuentas de máquina o cuentas vacías
| where isnotempty(TargetUserName) and TargetUserName !endswith "$" and TargetUserName != "-"
// Agrupar por dirección IP externa y ventana de tiempo
| summarize
    StartTime = min(TimeGenerated),
    EndTime = max(TimeGenerated),
    TotalFailedAttempts = count(),
    DistinctTargetUsers = dcount(TargetUserName),
    TargetUsersList = make_set(TargetUserName, 50),
    TargetComputers = make_set(Computer, 20),
    LogonTypes = make_set(LogonType, 10),
    SubStatusCodes = make_set(SubStatus, 10)
    by IpAddress, bin(TimeGenerated, lookbackWindow)
// Aplicar umbrales idénticos a detections.py
| where TotalFailedAttempts >= FailedLogonsThreshold and DistinctTargetUsers >= DistinctUsersThreshold
| extend
    RuleID = "R01",
    RuleName = "Password Spraying Attack",
    TechniqueID = "T1110.003",
    Tactic = "Credential Access",
    Severity = "Medium"
| project
    StartTime,
    EndTime,
    RuleID,
    RuleName,
    TechniqueID,
    Tactic,
    Severity,
    IpAddress,
    TotalFailedAttempts,
    DistinctTargetUsers,
    TargetUsersList,
    TargetComputers,
    LogonTypes,
    SubStatusCodes
